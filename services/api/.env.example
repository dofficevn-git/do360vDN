# DO360 API - sao thanh .env.production (prod/demo) hoac .env.development roi dien. KHONG commit.
NODE_ENV=production
PORT=3000
CORS_ORIGINS=http://localhost:3071

# -- CSDL --
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=do360

# -- JWT (>= 32 ky tu ngau nhien: openssl rand -hex 32) --
JWT_SECRET=
JWT_EXPIRES_IN=7d

# -- Tai khoan quan tri dau tien (API tu tao khi bang admin_users trong) --
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# -- Don vi mac dinh cua ban cai (ma DVHC cap xa theo QD 19/2025/QD-TTg) --
DEFAULT_TENANT_ID=
DEFAULT_TENANT_NAME=
DEFAULT_TENANT_TYPE=phuong
DEFAULT_TENANT_PARENT_ID=
DEFAULT_TENANT_PARENT_NAME=

# -- MinIO (Bronze: file goc) --
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=do360minio
MINIO_SECRET_KEY=
MINIO_BUCKET=do360-bronze

# -- Dich vu doc file / OCR (services/reader) --
READER_URL=http://reader:8000

# -- Thu muc cau hinh (danh muc chi tieu, Report Spec, luat boc tach) --
CONFIG_DIR=/config

# -- Kenh tam Zalo OA (truoc khi co API Tammi) - de trong neu chua dung --
ZALO_OA_ID=
ZALO_OA_APP_ID=
ZALO_OA_APP_SECRET=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=
ZALO_WEBHOOK_SECRET=

# KHONG co khoa AI nuoc ngoai nao o day: DO360/Tabot khong goi dich vu AI ngoai nuoc.

# -- Kenh chat (T1/T4): lien ket mo man xac nhan trong tin nhan --
WEB_PUBLIC_URL=http://localhost:3071

# -- D5 QLVB: sim (gia lap, chay tron luong trinh ky) | lgsp (truc LGSP Da Nang, chi co API doc) --
QLVB_MODE=sim
LGSP_TOKEN_URL=https://apiv2.danang.gov.vn/oauth2/token
LGSP_QLVB_URL=https://apiv2.danang.gov.vn/LGSP/QLVBDH/1.0
LGSP_CONSUMER_KEY=
LGSP_CONSUMER_SECRET=
QLVB_ORGAN_ID=
QLVB_ORGAN_KEY=

# -- Mini App Zalo (khu So lieu bao cao trong Mini App ZSC): APP_ID de the chat mo thang Mini App; them origin Zalo vao CORS --
MINIAPP_ID=
# CORS_ORIGINS can co: https://h5.zdn.vn (webview Mini App Zalo) khi chay that

# Chế độ demo: trang đăng nhập liệt kê tài khoản trong config/demo/<DEMO_SET>/accounts.yaml (tắt = để trống)
DEMO_MODE=
DEMO_SET=dien-ban-bac
